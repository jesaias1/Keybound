; Engine configuration file.
; Best edited using Godot 4.7.1.
config_version=5

[application]
config/name="Hopkey"
run/main_scene="res://scenes/main.tscn"
config/icon="res://assets/brand/hopkey_icon.png"
boot_splash/image="res://assets/brand/hopkey_logo.png"
boot_splash/fullsize=true
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.106, 0.09, 0.153, 1)

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.mobile="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.106, 0.09, 0.153, 1)

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=6
common/enable_pause_aware_picking=true

[input]
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"physical_keycode":4194309), Object(InputEventJoypadButton,"button_index":0)]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":1)]
}
